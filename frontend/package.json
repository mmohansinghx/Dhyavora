{
  "name": "@dhyavora/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js --host 0.0.0.0 --configLoader runner",
    "build": "node ../node_modules/typescript/bin/tsc -b tsconfig.json && node ../node_modules/vite/bin/vite.js build --configLoader runner",
    "typecheck": "node ../node_modules/typescript/bin/tsc -b tsconfig.json --pretty false",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.ts --configLoader runner",
    "lint": "node ../node_modules/eslint/bin/eslint.js src",
    "preview": "node ../node_modules/vite/bin/vite.js preview --host 0.0.0.0 --configLoader runner"
  },
  "dependencies": {
    "@dhyavora/contracts": "1.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.11",
    "firebase": "^12.19.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
