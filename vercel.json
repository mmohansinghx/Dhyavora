{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": { "api/**/*.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/dispatch?__api_path=v1/:path*" },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
