# Runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# Required to enable persistent API operations and readiness
MONGODB_URI=
MONGODB_DB_NAME=dhyavora_dev

# Firebase Admin: either provide all three fields or use Application Default Credentials
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional when using a service account JSON via GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web SDK (public Firebase config; Firebase rules still enforce access)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Encrypt OAuth tokens at rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# AI provider: none | openai | gemini. Keys are backend-only.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# GitHub OAuth (minimum requested scopes: read:user, user:email, repo read access only if needed)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/callback

# Optional payments adapter (not needed for free features)
PAYMENT_PROVIDER=none
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_PRICE_ID=
PAYMENT_WEBHOOK_SECRET=

# Optional email and opportunity integrations; unset providers report NOT_CONFIGURED
EMAIL_PROVIDER=none
EMAIL_API_KEY=
OPPORTUNITY_PROVIDER=none
OPPORTUNITY_API_KEY=
